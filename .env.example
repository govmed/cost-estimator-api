# Copy to .env and fill in values before running.
# Never commit .env to git.

# Postgres password (also used in docker-compose.yml)
POSTGRES_PASSWORD=devpassword

# Full SQLAlchemy connection string (overrides individual parts above)
DATABASE_URL=postgresql+psycopg2://sow_calc:devpassword@localhost:5432/sow_calc

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Authentication mode: standalone | oidc
AUTH_MODE=standalone

# Environment: development | production
ENVIRONMENT=development
