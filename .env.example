# Copy to .env and fill in values before running.
# Never commit .env to git.

# ── Application database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql+psycopg2://sow_calc:devpassword@localhost:5432/sow_calc

# ── FastAPI ───────────────────────────────────────────────────────────────────
# JWT signing secret (standalone mode only)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# AUTH_MODE=standalone  → local JWT (dev/CI)
# AUTH_MODE=oidc        → Authentik OIDC (staging/prod)
AUTH_MODE=standalone

ENVIRONMENT=development

# ── Authentik (required when AUTH_MODE=oidc) ──────────────────────────────────
# Authentik databases
AUTHENTIK_DB_PASSWORD=authentikdevpass

# The secret Authentik uses to sign its own tokens — must be strong in prod.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
AUTHENTIK_SECRET_KEY=authentik-dev-secret-change-in-production

# OIDC issuer URL — set after creating the provider in Authentik admin UI.
# Format: http://<host>:9000/application/o/<app-slug>/
AUTHENTIK_ISSUER=http://localhost:9000/application/o/cost-estimator/
